# ============ backend ============
backend/*.db
backend/laptops.db
# ^ QEYD: laptops.db ignore olunur. Amma Dockerfile onu SEED kimi COPY edir.
#   Mac-də clone-dan sonra deploy üçün ya bu faylı ayrıca köçür,
#   ya da bu 2 sətri sil → 260K-lıq ilkin seed commit olunsun, deploy hazır işləsin.
backend/laptops-backend          # kompilyasiya olunmuş Go binary
backend/web/                     # Docker build-də yaranan embed qovluğu (admin+sayt dist)
backend/imgcache/                # şəkil-proksi keşi — yenidən yaranır
*.exe
*.out

